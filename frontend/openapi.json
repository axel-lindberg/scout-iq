{
  "components": {
    "schemas": {
      "ChatRequest": {
        "properties": {
          "message": {
            "maxLength": 1000,
            "minLength": 1,
            "title": "Message",
            "type": "string"
          },
          "session_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Session Id"
          },
          "team": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/TeamContext"
              },
              {
                "type": "null"
              }
            ],
            "description": "The user's squad from the My team page, if loaded"
          }
        },
        "required": [
          "message"
        ],
        "title": "ChatRequest",
        "type": "object"
      },
      "ChatResponse": {
        "properties": {
          "answer": {
            "title": "Answer",
            "type": "string"
          },
          "session_id": {
            "title": "Session Id",
            "type": "string"
          },
          "tools": {
            "items": {
              "$ref": "#/components/schemas/ToolCall"
            },
            "title": "Tools",
            "type": "array"
          }
        },
        "required": [
          "session_id",
          "answer",
          "tools"
        ],
        "title": "ChatResponse",
        "type": "object"
      },
      "CompareResponse": {
        "properties": {
          "ambiguous": {
            "anyOf": [
              {
                "additionalProperties": {
                  "items": {
                    "type": "string"
                  },
                  "type": "array"
                },
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "description": "Names that match several players -> up to 5 candidates each. Absent if none.",
            "title": "Ambiguous"
          },
          "gameweek": {
            "title": "Gameweek",
            "type": "integer"
          },
          "not_found": {
            "anyOf": [
              {
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "description": "Names that match no player. Absent if none.",
            "title": "Not Found"
          },
          "players": {
            "items": {
              "$ref": "#/components/schemas/ComparedPlayer"
            },
            "title": "Players",
            "type": "array"
          }
        },
        "required": [
          "gameweek",
          "players"
        ],
        "title": "CompareResponse",
        "type": "object"
      },
      "ComparedPlayer": {
        "properties": {
          "chance_of_playing": {
            "title": "Chance Of Playing",
            "type": "integer"
          },
          "expected_points": {
            "title": "Expected Points",
            "type": "number"
          },
          "expected_points_adjusted": {
            "description": "expected_points x chance of playing",
            "title": "Expected Points Adjusted",
            "type": "number"
          },
          "expected_points_horizon_adjusted": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "description": "Sum of expected_points_adjusted over the horizon, only when horizon > 1",
            "title": "Expected Points Horizon Adjusted"
          },
          "fixtures": {
            "title": "Fixtures",
            "type": "string"
          },
          "full_name": {
            "title": "Full Name",
            "type": "string"
          },
          "gameweeks": {
            "anyOf": [
              {
                "items": {
                  "$ref": "#/components/schemas/GameweekPrediction"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "description": "Per-gameweek predictions, only when horizon > 1. Later ones are less certain.",
            "title": "Gameweeks"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "news": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "News"
          },
          "position": {
            "title": "Position",
            "type": "string"
          },
          "price": {
            "title": "Price",
            "type": "number"
          },
          "recent_form": {
            "$ref": "#/components/schemas/RecentForm"
          },
          "status": {
            "title": "Status",
            "type": "string"
          },
          "team": {
            "title": "Team",
            "type": "string"
          }
        },
        "required": [
          "name",
          "full_name",
          "team",
          "position",
          "price",
          "fixtures",
          "expected_points",
          "expected_points_adjusted",
          "chance_of_playing",
          "status",
          "news",
          "recent_form"
        ],
        "title": "ComparedPlayer",
        "type": "object"
      },
