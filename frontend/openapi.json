              },
              {
                "type": "null"
              }
            ],
            "description": "The FPL team, when loaded by team ID"
          },
          "free_transfers": {
            "title": "Free Transfers",
            "type": "integer"
          },
          "gameweeks": {
            "items": {
              "type": "integer"
            },
            "title": "Gameweeks",
            "type": "array"
          },
          "limitations": {
            "items": {
              "type": "string"
            },
            "title": "Limitations",
            "type": "array"
          },
          "lineup": {
            "$ref": "#/components/schemas/LineupOut"
          },
          "player_ids": {
            "items": {
              "type": "integer"
            },
            "title": "Player Ids",
            "type": "array"
          },
          "source": {
            "enum": [
              "fpl",
              "manual"
            ],
            "title": "Source",
            "type": "string"
          },
          "squad": {
            "description": "Starters (GK, DEF, MID, FWD) then the bench in order",
            "items": {
              "$ref": "#/components/schemas/SquadPlayer"
            },
            "title": "Squad",
            "type": "array"
          },
          "squad_expected_points": {
            "description": "Best XI + captain, per gameweek",
            "items": {
              "type": "number"
            },
            "title": "Squad Expected Points",
            "type": "array"
          },
          "transfer_pairs": {
            "items": {
              "$ref": "#/components/schemas/TransferOut"
            },
            "title": "Transfer Pairs",
            "type": "array"
          },
          "transfers": {
            "items": {
              "$ref": "#/components/schemas/TransferOut"
            },
            "title": "Transfers",
            "type": "array"
          },
          "warnings": {
            "items": {
              "type": "string"
            },
            "title": "Warnings",
            "type": "array"
          },
          "weakest": {
            "items": {
              "$ref": "#/components/schemas/WeakPlayer"
            },
            "title": "Weakest",
            "type": "array"
          }
        },
        "required": [
          "source",
          "player_ids",
          "gameweeks",
          "bank",
          "free_transfers",
          "squad",
          "lineup",
          "squad_expected_points",
          "weakest",
          "transfers",
          "transfer_pairs",
          "warnings",
          "limitations"
        ],
        "title": "TeamAnalysis",
        "type": "object"
      },
      "TeamContext": {
        "description": "The user's squad, sent with chat messages so the agent can analyse it.",
        "properties": {
          "bank": {
            "default": 0.0,
            "description": "\u00a3m",
            "maximum": 100.0,
            "minimum": 0.0,
            "title": "Bank",
            "type": "number"
          },
          "free_transfers": {
            "default": 1,
            "maximum": 5.0,
            "minimum": 0.0,
            "title": "Free Transfers",
            "type": "integer"
          },
          "player_ids": {
            "items": {
              "type": "integer"
            },
            "maxItems": 15,
            "minItems": 15,
            "title": "Player Ids",
            "type": "array"
          },
          "team_name": {
            "anyOf": [
              {
                "maxLength": 60,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Team Name"
          }
        },
        "required": [
          "player_ids"
        ],
        "title": "TeamContext",
        "type": "object"
      },
      "TeamRequest": {
        "properties": {
          "bank": {
            "anyOf": [
              {
                "maximum": 100.0,
                "minimum": 0.0,
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "description": "\u00a3m; default: from FPL, or 0",
            "title": "Bank"
          },
          "free_transfers": {
            "anyOf": [
              {
                "maximum": 5.0,
                "minimum": 0.0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "description": "Default: estimated from FPL, or 1",
            "title": "Free Transfers"
          },
          "horizon": {
            "default": 5,
            "maximum": 5.0,
            "minimum": 1.0,
            "title": "Horizon",
            "type": "integer"
          },
          "include_pairs": {
            "default": true,
            "title": "Include Pairs",
            "type": "boolean"
          },
          "player_ids": {
            "anyOf": [
              {
                "items": {
                  "type": "integer"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "description": "15 player ids, instead of team_id",
            "title": "Player Ids"
          },
          "team_id": {
            "anyOf": [
              {
                "minimum": 1.0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "description": "FPL team ID (the number in your Points page URL)",
            "title": "Team Id"
          }
        },
        "title": "TeamRequest",
        "type": "object"
      },
      "ToolCall": {
        "properties": {
          "args": {
            "description": "Arguments the agent passed (normally an object)",
            "title": "Args"
          },
          "tool": {
            "title": "Tool",
            "type": "string"
          }
        },
        "required": [
          "tool",
          "args"
        ],
        "title": "ToolCall",
        "type": "object"
      },
      "TransferOut": {
        "properties": {
          "bank_after": {
            "title": "Bank After",
            "type": "number"
          },
          "gain": {
            "description": "Expected points gained over the horizon, before hits",
            "title": "Gain",
            "type": "number"
          },
          "gain_per_gameweek": {
            "items": {
              "type": "number"
            },
            "title": "Gain Per Gameweek",
            "type": "array"
          },
          "hits": {
            "description": "Points deducted: 4 per transfer beyond the free ones",
            "title": "Hits",
            "type": "integer"
          },
          "in": {
            "items": {
              "$ref": "#/components/schemas/SquadPlayerBrief"
            },
            "title": "In",
            "type": "array"
          },
          "net_gain": {
            "title": "Net Gain",
            "type": "number"
          },
          "out": {
            "items": {
              "$ref": "#/components/schemas/SquadPlayerBrief"
            },
            "title": "Out",
            "type": "array"
          }
        },
        "required": [
          "out",
          "in",
          "gain_per_gameweek",
          "gain",
          "hits",
          "net_gain",
          "bank_after"
        ],
        "title": "TransferOut",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      },
      "WeakPlayer": {
        "properties": {
          "expected_points_horizon_adjusted": {
            "title": "Expected Points Horizon Adjusted",
            "type": "number"
          },
          "id": {
            "title": "Id",
            "type": "integer"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "reason": {
            "enum": [
              "unavailable",
              "doubtful",
              "low expected points"
            ],
            "title": "Reason",
            "type": "string"
          }
        },
        "required": [
          "id",
          "name",
          "reason",
          "expected_points_horizon_adjusted"
        ],
        "title": "WeakPlayer",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "scout-iq",
    "version": "1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/chat": {
      "post": {
        "operationId": "chat_api_chat_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ChatRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ChatResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Chat"
      }
    },
    "/api/compare": {
      "get": {
        "operationId": "compare_api_compare_get",
        "parameters": [
          {
            "in": "query",
            "name": "names",
            "required": true,
            "schema": {
              "items": {
                "type": "string"
              },
              "maxItems": 6,
              "minItems": 1,
              "title": "Names",
              "type": "array"
            }
          },
          {
            "in": "query",
            "name": "horizon",
            "required": false,
            "schema": {
              "default": 1,
              "maximum": 5,
              "minimum": 1,
              "title": "Horizon",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CompareResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Compare"
      }
    },
    "/api/news": {
      "get": {
        "operationId": "news_api_news_get",
        "parameters": [
          {
            "in": "query",
            "name": "q",
            "required": true,
            "schema": {
              "minLength": 2,
              "title": "Q",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "top_k",
            "required": false,
            "schema": {
              "default": 5,
              "maximum": 10,
              "minimum": 1,
              "title": "Top K",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "News"
      }
    },
    "/api/players": {
      "get": {
        "operationId": "players_api_players_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PlayersResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Players"
      }
    },
    "/api/predictions": {
      "get": {
        "operationId": "predictions_api_predictions_get",
        "parameters": [
          {
            "in": "query",
            "name": "position",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Position"
            }
          },
          {
            "in": "query",
            "name": "max_price",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "exclusiveMinimum": 0,
                  "type": "number"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Max Price"
            }
          },
          {
            "in": "query",
            "name": "team",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Team"
            }
          },
          {
            "in": "query",
            "name": "top_n",
            "required": false,
            "schema": {
              "default": 20,
              "maximum": 30,
              "minimum": 1,
              "title": "Top N",
              "type": "integer"
            }
          },
          {
            "in": "query",
            "name": "include_unavailable",
            "required": false,
            "schema": {
              "default": false,
              "title": "Include Unavailable",
              "type": "boolean"
            }
          },
          {
            "description": "Gameweeks ahead (1 = next only)",
            "in": "query",
            "name": "horizon",
            "required": false,
            "schema": {
              "default": 1,
              "description": "Gameweeks ahead (1 = next only)",
              "maximum": 5,
              "minimum": 1,
              "title": "Horizon",
              "type": "integer"
            }
          },
          {
            "in": "query",
            "name": "rank_by",
            "required": false,
            "schema": {
              "default": "next",
              "enum": [
                "next",
                "horizon"
              ],
              "title": "Rank By",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PredictionsResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Predictions"
      }
    },
    "/api/status": {
      "get": {
        "operationId": "status_api_status_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StatusResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Status"
      }
    },
    "/api/team/analyze": {
      "post": {
        "operationId": "analyze_team_api_team_analyze_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TeamRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TeamAnalysis"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Analyze Team"
      }
    }
  }
}
